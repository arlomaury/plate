# Copy these into Vercel > Project > Settings > Environment Variables.
# Never commit real values. .env files are ignored by git.

# Required - from console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Required - from Supabase > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Recommended - comma-separated emails allowed to run estimates.
# Without this, anyone who signs up on your deployment can spend your API credits.
ALLOWED_EMAILS=you@example.com

# Optional
# ALLOWED_ORIGIN=https://your-app.vercel.app
# ESTIMATE_MODEL=claude-haiku-4-5-20251001
